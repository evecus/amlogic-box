# === 平台裁剪: 只保留 Amlogic Meson,关闭其余平台(含 Rockchip) ===
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_AIROHA=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_ARTPEC=n
CONFIG_ARCH_AXIADO=n
CONFIG_ARCH_BCM_IPROC=n
CONFIG_ARCH_BCM2835=n
CONFIG_ARCH_BCMBCA=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_BITMAIN=n
CONFIG_ARCH_BLAIZE=n
CONFIG_ARCH_BRCMSTB=n
CONFIG_ARCH_BST=n
CONFIG_ARCH_CIX=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_LAN969X=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=y
CONFIG_ARCH_MMP=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_PENSANDO=n
CONFIG_ARCH_QCOM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_S32=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_SOPHGO=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_TESLA_FSD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n

# === 显示: 保留 HDMI 输出 (meson DRM, 调试/接屏用) ===
# 音频仍关闭;以后要 HDMI 声卡,删掉下面 SOUND 行并在 amlogic.fragment 开 ASoc
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_STAGING=n

# === 虚拟化/Xen(板上不跑虚拟机) ===
CONFIG_VIRTUALIZATION=n
CONFIG_XEN=n

# === PCI(e) 保留: WXY-OES 的 SATA 走 PCIe(AHCI),不能关 ===

# === 杂项省资源 ===
# 注意: FW_LOADER 必须保持开启(wifi 驱动通过 request_firmware 加载固件),勿关
CONFIG_KEXEC=n
CONFIG_CRASH_DUMP=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
CONFIG_ARM_PSCI_CPUIDLE=n
# 全内建: 不再产出 /lib/modules,板上安装更简单(fragment 里的 =m 会被强制转为 =y)
# 如果想保留模块化(便于单独替换驱动),删掉下面这行
CONFIG_MODULES=n
# CONFIG_BT_HCIAIC8800 is not set
CONFIG_BT_HCIAIC8800=n
