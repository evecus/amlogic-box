# Amlogic 盒子内核片段 — 基于 arm64 defconfig 叠加
# 用法:
#   make ARCH=arm64 defconfig
#   ./scripts/kconfig/merge_config.sh -m .config \
#     kernel-config/slim-amlogic.fragment \
#     kernel-config/amlogic.fragment
#   make ARCH=arm64 olddefconfig
# 覆盖机型: Phicomm-N1(S905D) / CM311-1a-CH(S905L3A) / M302A(S905L3B) / WXY-OES(A311D)
# 参考基线: panther-x2.fragment 的通用部分 + meson 平台驱动

# 明确关闭 NBD，避免因全内建被 olddefconfig 强制转成 =y
CONFIG_BLK_DEV_NBD=n
# --- SoC 基础 (GXL/G12A/G12B 通吃) ---
CONFIG_ARCH_MESON=y
# KASLR: ophub 关闭; Amlogic 老 vendor u-boot 内存环境下超早期崩溃嫌疑, 对齐关闭
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RANDOMIZE_MODULE_REGION_FULL is not set
CONFIG_MESON_GX_SOCINFO=y
CONFIG_MESON_SM=y
CONFIG_COMMON_CLK_MESON_REGMAP=y
CONFIG_COMMON_CLK_GXBB=y
CONFIG_COMMON_CLK_AXG=y
CONFIG_COMMON_CLK_G12A=y
CONFIG_RESET_MESON=y
CONFIG_PINCTRL_MESON=y
# GPIO 由 pinctrl-meson 驱动提供, 无独立 GPIO_MESON 符号
# gpio 中断控制器 (ephy link / 按键等全部依赖; 正确符号名是 MESON_IRQ_GPIO)
CONFIG_MESON_IRQ_GPIO=y
CONFIG_MESON_CLK_MEASURE=y
# GX PM_DOMAINS 在 7.1.13 已并入 MESON_EE_PM_DOMAINS (default ARCH_MESON)
CONFIG_MESON_EE_PM_DOMAINS=y
CONFIG_MESON_SECURE_PM_DOMAINS=y

# --- ophub 私有 WiFi/BT 驱动已拆到 ophub-private.fragment ---
# SSV6051 / AIC8800 是 ophub out-of-tree 符号, 主线源码里没有, 只在
# build-kernel-ophub.yml (源码 = ophub/linux-6.18.y) 中由该 fragment 启用。
# N1 是 Broadcom BCM43455, 走主线 brcmfmac, 与这些符号无关。

# --- CPU 调频 (cpufreq-dt + opp-table) ---
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
# WXY-OES 双簇调压走 pwm-regulator
CONFIG_REGULATOR_PWM=y

# --- 有线网 ---
# stmmac glue 层 (7.1.13 已合并为统一符号 DWMAC_MESON, 覆盖 GXL/G12 系列)
CONFIG_DWMAC_MESON=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_GENERIC=y
# MDIO mux (GXL 外部 mdio / G12A 内部切换)
CONFIG_MDIO_BUS_MUX_MESON_GXL=y
CONFIG_MDIO_BUS_MUX_MESON_G12A=y
# 内部百兆 PHY (GXL/G12A 内部 ephy)
CONFIG_MESON_GXL_PHY=y
# WXY-OES 外挂 RTL8211F 千兆 PHY
CONFIG_REALTEK_PHY=y

# --- 存储 ---
CONFIG_MMC_MESON_GX=y
CONFIG_MMC_PWRSEQ_EMMC=y
CONFIG_MMC_PWRSEQ_SIMPLE=y
# WXY-OES: SATA 经 PCIe (AHCI)
CONFIG_PCI=y
CONFIG_PCI_MESON=y
CONFIG_SATA_AHCI=y  # 7.1.13 已合并 PCI AHCI 支持, 无独立 SATA_AHCI_PCI

# --- USB ---
CONFIG_USB_DWC3_MESON_G12A=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_XHCI_PLATFORM=y   # dwc3 host 模式必需
CONFIG_USB_ROLE_SWITCH=y
# N1/M302A (GXL 系) USB2 PHY; 7.1.13 中 GXL 用 GXL_USB2, MESON8B 是 32 位老平台
CONFIG_PHY_MESON_GXL_USB2=y
CONFIG_PHY_MESON_G12A_USB2=y
CONFIG_PHY_MESON_G12A_USB3_PCIE=y

# --- HDMI 显示输出 (meson DRM + dw-hdmi) ---
CONFIG_DRM=y
CONFIG_DRM_MESON=y
CONFIG_DRM_MESON_DW_HDMI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_CEC_MESON_AO=y   # 7.1.13 符号名 (旧名 CEC_MESON_GX 已废)

# --- 板载外设 ---
CONFIG_I2C_MESON=y
CONFIG_PWM_MESON=y
CONFIG_MESON_SARADC=y
CONFIG_AMLOGIC_THERMAL=y
# --- 看门狗 (关键: Amlogic vendor u-boot 启动内核前留 WDT 在跑, Amlogic WDT 无法关闭
#     只能喂; 必须让内核接管喂狗, 否则 WDT 超时硬复位 -> 开机无限重启循环; 对齐 ophub 配置) ---
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
# CONFIG_WATCHDOG_NOWAYOUT is not set
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0
CONFIG_MESON_GXBB_WATCHDOG=y
CONFIG_MESON_WATCHDOG=y
CONFIG_IR_MESON=y   # 7.1.13 符号名 (旧名 MESON_IR 已废)
CONFIG_RTC_DRV_MESON=y
CONFIG_RTC_DRV_MESON_VRTC=y
# WXY-OES: 风扇/按键/LED
CONFIG_SENSORS_GPIO_FAN=y
CONFIG_KEYBOARD_GPIO_POLLED=y
CONFIG_LEDS_GPIO=y
CONFIG_GPIO_SYSFS=y   # /sys/class/gpio, LED/IO 脚本需要 (ophub parity)
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_LEDS_TRIGGER_DISK=y   # 7.1.13 符号名

# --- tproxy 透明代理 (sing-box/mihomo,iptables 与 nftables 双栈) ---
CONFIG_NF_SOCKET_IPV4=m
CONFIG_NF_SOCKET_IPV6=m
CONFIG_NF_TPROXY_IPV4=m
CONFIG_NF_TPROXY_IPV6=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_TPROXY=m

# --- iptables (legacy xt) 常用项 ---
CONFIG_NF_NAT=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_NAT=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_NETMAP=m
CONFIG_NETFILTER_XT_MATCH_STATE=m

# --- nftables 基础栈 (Debian 12 默认防火墙) ---
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_COMPAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
# DNS 劫持 redirect / 分流 fib 表达式 (nexa/sing-box/mihomo 必需)
CONFIG_NFT_REDIR=m
CONFIG_NFT_REDIR_IPV4=m
CONFIG_NFT_REDIR_IPV6=m
CONFIG_NFT_REDIR_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m

# --- cgroup 分流 (v2) ---
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_NET_CLS_CGROUP=m

# --- 策略路由 (透明代理 fwmark 分流必需) ---
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_CLASSID=y

# --- ipset (老规则/批量地址表) ---
CONFIG_IP_SET=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_IPPORT=m
CONFIG_IP_SET_HASH_NETPORT=m
CONFIG_IP_SET_HASH_IPPORTNET=m
CONFIG_NETFILTER_XT_SET=m

# --- 诊断 (ss -t/-u/-x 需要) ---
CONFIG_INET_UDP_DIAG=m
CONFIG_UNIX_DIAG=m
CONFIG_PACKET_DIAG=m
CONFIG_NETLINK_DIAG=m

# --- zram/zswap (低内存 swap 压缩) ---
CONFIG_ZRAM=m
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y

# --- 容器/虚拟网络模式 (docker macvlan/ipvlan/vxlan) ---
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_IPVLAN=m
CONFIG_IPVTAP=m
CONFIG_VXLAN=m

# --- SMB 服务器 (可选,不装 samba 服务可删) ---
CONFIG_KSMBD=m

# --- QoS 限速 (可选,不用 sqm 可删) ---
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y

# --- BBR 拥塞控制 (99-bbr.conf 需要;defconfig 默认只有 cubic) ---
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y

# --- WireGuard / 常用防火墙 match (对齐 ophub 功能集) ---
CONFIG_WIREGUARD=y
CONFIG_CRYPTO_DEV_AMLOGIC_GXL=y   # GXL 硬件加密引擎 (ophub parity)
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y   # 7.1.13: AES-CE 单块驱动并入 CE_BLK
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_NETFILTER_XT_MATCH_CGROUP=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# --- THP 默认 madvise 模式 (choice 三选一,必须显式关 ALWAYS) ---
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=n

# --- 按需扩展: IPsec / IPVS / ebtables / KVM / NAS / 国密 / flow offload ---
# IPsec (strongswan/setkey 需要)
CONFIG_NET_KEY=y
CONFIG_XFRM_USER=y
CONFIG_INET_ESP=y
CONFIG_INET_ESP_OFFLOAD=y
CONFIG_INET6_ESP=y
CONFIG_INET6_ESP_OFFLOAD=y
# IPVS (LVS 负载均衡, k8s/swarm 场景)
CONFIG_IP_VS=y
CONFIG_IP_VS_IPV6=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_LC=y
CONFIG_IP_VS_WLC=y
CONFIG_IP_VS_LBLC=y
CONFIG_IP_VS_DH=y
CONFIG_IP_VS_SH=y
CONFIG_IP_VS_SED=y
CONFIG_IP_VS_NQ=y
CONFIG_IP_VS_MH=y
# KVM (覆盖 slim 的 VIRTUALIZATION=n)
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
# NAS 客户端 (挂 NFS/SMB 共享)
CONFIG_NFS_FS=y
CONFIG_CIFS=y
# 国密硬件加速 (ARMv8.2 CE)
# CONFIG_CRYPTO_SM3_ARM64_CE 已在 7.1.13 移除, SM3 走 generic 实现
CONFIG_CRYPTO_SM4_ARM64_CE=y
CONFIG_CRYPTO_SM4_ARM64_CE_BLK=y
CONFIG_CRYPTO_SM4_ARM64_CE_CCM=y
CONFIG_CRYPTO_SM4_ARM64_CE_GCM=y
# flow offload (NAT 加速;与 tproxy 共用时注意规则优先级,可整段删)
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_NFT_FLOW_OFFLOAD=y

CONFIG_ARM64_VA_BITS=48
CONFIG_ARM64_PA_BITS=48
